<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="LifeManagementApp.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:LifeManagementApp.Views"
       Shell.FlyoutBehavior="Disabled"
       Title="LifeManagementApp">

    <!-- Kaks välilehteä. DataTemplate -> sivu luodaan DI:n kautta vasta kun sitä tarvitaan -->
    <TabBar>
        <ShellContent Title="Home"
                      Route="home"
                      ContentTemplate="{DataTemplate views:HomePage}" />
        <ShellContent Title="To-dos"
                      Route="todos"
                      ContentTemplate="{DataTemplate views:TodoListPage}" />
    </TabBar>

</Shell>
